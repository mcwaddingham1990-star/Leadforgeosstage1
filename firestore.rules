rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserProfile() {
      return get(/databases/$(database)/documents/user_profiles/$(request.auth.uid)).data;
    }

    function getBusinessEmail() {
      return getUserProfile().businessEmail;
    }

    // Fast path uses the auth token's own email directly (no cross-document
    // lookup) to cover the common owner case; falls back to the profile
    // lookup for employees whose businessId is their owner's email.
    //
    // SECURITY: the `businessId is string && businessId.size() > 0` guard
    // matters -- without it, a document missing its businessId field (a
    // malformed write, or a caller explicitly omitting it) makes this
    // compare against `null`. getBusinessEmail() also returns null for a
    // caller whose own profile happens to be missing businessEmail, so
    // `null == null` would otherwise evaluate true and grant that caller
    // access to a businessId-less document regardless of which business it
    // belongs to. Requiring a real non-empty string closes that off.
    function isBusinessMember(businessId) {
      return businessId is string && businessId.size() > 0 &&
        (request.auth.token.email == businessId || getBusinessEmail() == businessId);
    }

    // Only owners and managers may create or modify eSign / PDF documents.
    function isManager() {
      return getUserProfile().role in [
        "Owner", "General Manager", "Office Manager",
        "Operations Manager", "HR Manager", "Payroll Manager",
        "HR", "Payroll", "Admin"
      ];
    }

    function canManageProjectCompletion(businessId) {
      return request.auth.token.email == businessId || getUserProfile().role in [
        "Owner", "Manager", "General Manager", "Office Manager",
        "Operations Manager", "Scheduler", "Dispatch", "Dispatcher"
      ];
    }

    // SECURITY: businessId is required and checked against the job's own
    // record -- without it, a jobId belonging to a DIFFERENT business whose
    // assignedEmployee/assignedCrew text happens to match this caller's own
    // name/email would satisfy the assignment check below, letting a
    // project_completion_plans write for the caller's own business ride in
    // on a coincidental cross-business name match instead of a real
    // assignment on a job that business actually owns.
    function isAssignedToJob(jobId, businessId) {
      let job = get(/databases/$(database)/documents/scheduling_events/$(jobId)).data;
      let profile = getUserProfile();
      return job.businessId == businessId
        && (job.assignedEmployee == request.auth.token.email
          || job.assignedEmployee == profile.name
          || job.assignedEmployee == profile.firstName + " " + profile.lastName
          || job.assignedEmployee == profile.email
          || job.assignedCrew == profile.name);
    }

    // Profiles collection: users can read/write their own profiles.
    //
    // SECURITY: `businessEmail` and `role` on this document are the roots of
    // trust for the whole ruleset -- isBusinessMember() and isManager() above
    // read them straight off this doc. The original rule let a user
    // (request.auth.uid == uid) write *any* field of their own profile
    // unconditionally, which meant any authenticated user could self-edit
    // businessEmail to a victim business's email and role to "Owner" and
    // instantly gain full read/write over that business's data in every
    // other collection below -- a complete tenant-isolation and
    // privilege-escalation bypass. Self-writes may still touch every other
    // field (name, goals, permissions, etc., same as before); only
    // businessEmail/role are pinned once a profile exists. The other-member
    // branch (in practice: the business owner, whose auth token email
    // equals businessEmail -- see isBusinessMember's comment above) keeps
    // its original, unrestricted ability to edit an employee's profile
    // (e.g. RosterPage's role editor), unchanged from before.
    match /user_profiles/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || (resource != null && resource.data.businessEmail == request.auth.token.email));
      // SECURITY: the update rule below already pins businessEmail/role once
      // a profile exists, but that comparison needs a `resource` to compare
      // against -- on CREATE there isn't one yet, so without a check here a
      // brand-new authenticated user could set their own first profile's
      // businessEmail to any OTHER business's email (and role to "Owner")
      // and instantly inherit full read/write over that business's data via
      // isBusinessMember() everywhere else in this ruleset. Only two ways to
      // legitimately land a first businessEmail/role are now allowed:
      // (a) a real Owner self-signup, where businessEmail can only be the
      //     signer-upper's own verified auth email and role only "Owner"
      //     (matches App.tsx's owner-signup flows, which always set both
      //     this way); or (b) redeeming a real, still-open
      //     employee_invites/{code} doc -- which itself can only ever be
      //     created by an existing real member of that business
      //     (isBusinessMember() in that collection's own create rule) -- and
      //     the new profile's businessEmail/role must match that invite
      //     exactly, not whatever the new account claims. App.tsx's
      //     invite-signup flow now stamps the redeemed code onto the new
      //     profile as `inviteCode` specifically so this can verify it.
      allow create: if isAuthenticated() && request.auth.uid == uid && (
        (request.resource.data.businessEmail == request.auth.token.email && request.resource.data.role == "Owner")
        || (
          request.resource.data.inviteCode is string &&
          get(/databases/$(database)/documents/employee_invites/$(request.resource.data.inviteCode)).data.status == "pending" &&
          get(/databases/$(database)/documents/employee_invites/$(request.resource.data.inviteCode)).data.businessEmail == request.resource.data.businessEmail &&
          get(/databases/$(database)/documents/employee_invites/$(request.resource.data.inviteCode)).data.role == request.resource.data.role
        )
      );
      allow update: if isAuthenticated() && (
        (request.auth.uid == uid
          && request.resource.data.businessEmail == resource.data.businessEmail
          && request.resource.data.role == resource.data.role)
        || resource.data.businessEmail == request.auth.token.email
      );
      allow delete: if isAuthenticated() && resource.data.businessEmail == request.auth.token.email;
    }

    // Business profiles: owners can read/write their business profile.
    //
    // SECURITY: subscriptionActive/subscriptionStatus/subscriptionCurrentPeriodEnd/
    // subscriptionCancelAtPeriodEnd/stripeSubscriptionCustomerId (server/
    // subscriptionRoutes.ts + server/stripeWebhook.ts) and bypassActive/
    // bypassExpiresAt (server/paywallBypass.ts) are the OwnersLOCAL paywall's
    // entire source of truth, and both are written exclusively through the
    // Firebase Admin SDK -- which bypasses these rules entirely, so this
    // costs those legitimate writes nothing. Without this restriction, any
    // business's own signed-in client could open devtools and
    // `setDoc(business_profiles/<their email>, {subscriptionActive: true})`
    // themselves, permanently defeating the entire paywall -- every existing
    // client write to this collection already uses `{merge: true}` (see
    // SettingsPage.tsx, RosterPage.tsx, UniversalAIIntake.tsx, App.tsx),
    // so blocking these specific keys from ever appearing in a client write
    // doesn't touch any real field those callers actually set.
    match /business_profiles/{email} {
      allow read: if isAuthenticated() && isBusinessMember(email);
      allow create: if isAuthenticated() && isBusinessMember(email) &&
        !request.resource.data.keys().hasAny([
          'subscriptionActive', 'subscriptionStatus', 'subscriptionCurrentPeriodEnd',
          'subscriptionCancelAtPeriodEnd', 'stripeSubscriptionCustomerId',
          'bypassActive', 'bypassExpiresAt'
        ]);
      allow update: if isAuthenticated() && isBusinessMember(email) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'subscriptionActive', 'subscriptionStatus', 'subscriptionCurrentPeriodEnd',
          'subscriptionCancelAtPeriodEnd', 'stripeSubscriptionCustomerId',
          'bypassActive', 'bypassExpiresAt'
        ]);
      allow delete: if isAuthenticated() && isBusinessMember(email);
    }

    // Employee invites: the code must stay readable pre-signup (an
    // unauthenticated visitor looks it up by code before they have an
    // account to prove tenancy with), but creating/updating one now requires
    // being a real member of the business the invite is being issued for --
    // it was previously `if true`, letting anyone on the internet mint an
    // invite for any business (e.g. role: "Owner") and then use it during
    // signup to join that business with any role they chose.
    match /employee_invites/{code} {
      allow read: if true;
      allow create: if isAuthenticated() && isBusinessMember(request.resource.data.businessEmail);
      // Update also covers the invited user marking their own invite
      // "completed" right after they create their account -- by then their
      // own user_profile.businessEmail already matches this invite's
      // businessEmail (set in the same signup flow, just before this call),
      // so isBusinessMember(resource.data.businessEmail) covers them too.
      allow update: if isAuthenticated() && isBusinessMember(resource.data.businessEmail);
      allow delete: if isAuthenticated() && isBusinessMember(resource.data.businessEmail);
    }

    // Employees collection
    match /employees/{email} {
      allow read, delete: if isAuthenticated() && isBusinessMember(resource.data.businessEmail);
      allow create, update: if isAuthenticated() && isBusinessMember(request.resource.data.businessEmail);
    }

    // Standard business collections — all scoped to businessId
    // (owner's email is the tenant key; employees have businessEmail in their
    // user_profile pointing back to the owner, handled by isBusinessMember)
    //
    // SECURITY: every "allow create, update" / "allow delete" pair below
    // used to be one combined "allow write" line reading
    // `request.resource == null || isBusinessMember(request.resource.data.businessId)`.
    // request.resource is null on a DELETE (there's no resulting document),
    // so that first half authorized EVERY delete unconditionally for any
    // authenticated user, regardless of which business the document
    // actually belonged to -- it never reached the isBusinessMember check at
    // all. Split so delete checks the EXISTING document's own businessId
    // (`resource.data`, not `request.resource.data`) instead of skipping it.

    match /customers/{docId} {
      allow create, update: if isAuthenticated() && isBusinessMember(request.resource.data.businessId);
      allow delete: if isAuthenticated() && isBusinessMember(resource.data.businessId);
      allow read: if isAuthenticated() && isBusinessMember(resource.data.businessId);
    }
    match /leads/{docId} {
      allow create, update: if isAuthenticated() && isBusinessMember(request.resource.data.businessId);
      allow delete: if isAuthenticated() && isBusinessMember(resource.data.businessId);
      allow read: if isAuthenticated() && isBusinessMember(resource.data.businessId);
    }
    match /estimates/{docId} {
      allow create, update: if isAuthenticated() && isBusinessMember(request.resource.data.businessId);
      allow delete: if isAuthenticated() && isBusinessMember(resource.data.businessId);
      allow read: if isAuthenticated() && isBusinessMember(resource.data.businessId);
    }
    match /scheduling_events/{docId} {
      allow create, update: if isAuthenticated() && isBusinessMember(request.resource.data.businessId);
      allow delete: if isAuthenticated() && isBusinessMember(resource.data.businessId);
      allow read: if isAuthenticated() && isBusinessMember(resource.data.businessId);
    }
    match /inventory/{docId} {
      // SECURITY: same request.resource-is-null-on-delete fix as the
      // standard business collections above -- delete now checks the
      // EXISTING item's own businessId instead of skipping the check.
      allow create: if isAuthenticated() && isBusinessMember(request.resource.data.businessId);
      allow delete: if isAuthenticated() && isBusinessMember(resource.data.businessId);
      // Stock reductions are approval actions. All other inventory edits retain
      // the existing tenant permission behavior.
      allow update: if isAuthenticated() && isBusinessMember(request.resource.data.businessId)
        && (request.resource.data.quantity >= resource.data.quantity || canManageProjectCompletion(request.resource.data.businessId));
      allow read: if isAuthenticated() && isBusinessMember(resource.data.businessId);
    }
    match /project_completion_plans/{jobId} {
      allow read: if isAuthenticated() && isBusinessMember(resource.data.businessId);
      allow create: if isAuthenticated() && isBusinessMember(request.resource.data.businessId)
        && request.resource.data.jobId == jobId
        && (canManageProjectCompletion(request.resource.data.businessId) || isAssignedToJob(jobId, request.resource.data.businessId));
      allow delete: if isAuthenticated() && isBusinessMember(resource.data.businessId)
        && canManageProjectCompletion(resource.data.businessId);
      allow update: if isAuthenticated() && isBusinessMember(request.resource.data.businessId)
        && request.resource.data.businessId == resource.data.businessId
        && request.resource.data.jobId == resource.data.jobId
        && (
          canManageProjectCompletion(request.resource.data.businessId)
          || (isAssignedToJob(resource.data.jobId, resource.data.businessId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['goals', 'activity', 'updatedAt']))
        );
    }
    match /documents/{docId} {
      // eSign / PDF documents (folder == "eSign") can only be written by managers.
      // All other document types (uploads, receipts, photos, etc.) are open to any business member.
      allow write: if isAuthenticated() && (
        request.resource == null
          ? isBusinessMember(resource.data.businessId)
          : (isBusinessMember(request.resource.data.businessId) &&
             (request.resource.data.folder != "eSign" || isManager()))
      );
      allow read: if isAuthenticated() && isBusinessMember(resource.data.businessId);
    }
    match /document_folders/{docId} {
      allow create, update: if isAuthenticated() && isBusinessMember(request.resource.data.businessId);
      allow delete: if isAuthenticated() && isBusinessMember(resource.data.businessId);
      allow read: if isAuthenticated() && isBusinessMember(resource.data.businessId);
    }
    match /roster/{docId} {
      allow create, update: if isAuthenticated() && isBusinessMember(request.resource.data.businessId);
      allow delete: if isAuthenticated() && isBusinessMember(resource.data.businessId);
      allow read: if isAuthenticated() && isBusinessMember(resource.data.businessId);
    }
    match /courses/{docId} {
      allow create, update: if isAuthenticated() && isBusinessMember(request.resource.data.businessId);
      allow delete: if isAuthenticated() && isBusinessMember(resource.data.businessId);
      allow read: if isAuthenticated() && isBusinessMember(resource.data.businessId);
    }
    match /training_profiles/{docId} {
      allow create, update: if isAuthenticated() && isBusinessMember(request.resource.data.businessId);
      allow delete: if isAuthenticated() && isBusinessMember(resource.data.businessId);
      allow read: if isAuthenticated() && isBusinessMember(resource.data.businessId);
    }
    match /bulletins/{docId} {
      allow create, update: if isAuthenticated() && isBusinessMember(request.resource.data.businessId);
      allow delete: if isAuthenticated() && isBusinessMember(resource.data.businessId);
      allow read: if isAuthenticated() && isBusinessMember(resource.data.businessId);
    }
    match /notifications/{docId} {
      // Any business member may create a notification (e.g. an employee's
      // clock-in creating an approval request addressed to their manager),
      // but only the addressed recipient may read, mark it read, or delete
      // it -- a notification is not a shared business-wide broadcast.
      allow create: if isAuthenticated() && isBusinessMember(request.resource.data.businessId);
      allow read, update, delete: if isAuthenticated() && isBusinessMember(resource.data.businessId)
        && resource.data.recipientEmail == request.auth.token.email;
    }
    match /recent_ai_actions/{docId} {
      allow create, update: if isAuthenticated() && isBusinessMember(request.resource.data.businessId);
      allow delete: if isAuthenticated() && isBusinessMember(resource.data.businessId);
      allow read: if isAuthenticated() && isBusinessMember(resource.data.businessId);
    }
    match /snapshots/{docId} {
      allow create, update: if isAuthenticated() && isBusinessMember(request.resource.data.businessId);
      allow delete: if isAuthenticated() && isBusinessMember(resource.data.businessId);
      allow read: if isAuthenticated() && isBusinessMember(resource.data.businessId);
    }

    // Work Orders, Price Book, Memberships, Purchase Orders, Review Requests:
    // src/App.tsx's useFirestoreCollection calls for "work_orders",
    // "price_book_folders", "price_book_models", "memberships",
    // "purchase_orders", and "review_requests" had no matching rule here at
    // all, so every read/write to these tenant-scoped collections was
    // silently denied by Firestore's default-deny -- same isBusinessMember
    // scoping as every other standard business collection above.
    match /work_orders/{docId} {
      allow create, update: if isAuthenticated() && isBusinessMember(request.resource.data.businessId);
      allow delete: if isAuthenticated() && isBusinessMember(resource.data.businessId);
      allow read: if isAuthenticated() && isBusinessMember(resource.data.businessId);
    }
    match /price_book_folders/{docId} {
      allow create, update: if isAuthenticated() && isBusinessMember(request.resource.data.businessId);
      allow delete: if isAuthenticated() && isBusinessMember(resource.data.businessId);
      allow read: if isAuthenticated() && isBusinessMember(resource.data.businessId);
    }
    match /price_book_models/{docId} {
      allow create, update: if isAuthenticated() && isBusinessMember(request.resource.data.businessId);
      allow delete: if isAuthenticated() && isBusinessMember(resource.data.businessId);
      allow read: if isAuthenticated() && isBusinessMember(resource.data.businessId);
    }
    match /memberships/{docId} {
      allow create, update: if isAuthenticated() && isBusinessMember(request.resource.data.businessId);
      allow delete: if isAuthenticated() && isBusinessMember(resource.data.businessId);
      allow read: if isAuthenticated() && isBusinessMember(resource.data.businessId);
    }
    match /purchase_orders/{docId} {
      allow create, update: if isAuthenticated() && isBusinessMember(request.resource.data.businessId);
      allow delete: if isAuthenticated() && isBusinessMember(resource.data.businessId);
      allow read: if isAuthenticated() && isBusinessMember(resource.data.businessId);
    }
    match /review_requests/{docId} {
      allow create, update: if isAuthenticated() && isBusinessMember(request.resource.data.businessId);
      allow delete: if isAuthenticated() && isBusinessMember(resource.data.businessId);
      allow read: if isAuthenticated() && isBusinessMember(resource.data.businessId);
    }

    // Financial / accounting collections
    match /transactions/{docId} {
      allow create, update: if isAuthenticated() && isBusinessMember(request.resource.data.businessId);
      allow delete: if isAuthenticated() && isBusinessMember(resource.data.businessId);
      allow read: if isAuthenticated() && isBusinessMember(resource.data.businessId);
    }
    match /journal_entries/{docId} {
      allow create, update: if isAuthenticated() && isBusinessMember(request.resource.data.businessId);
      allow delete: if isAuthenticated() && isBusinessMember(resource.data.businessId);
      allow read: if isAuthenticated() && isBusinessMember(resource.data.businessId);
    }
    match /revenue_events/{docId} {
      allow create, update: if isAuthenticated() && isBusinessMember(request.resource.data.businessId);
      allow delete: if isAuthenticated() && isBusinessMember(resource.data.businessId);
      allow read: if isAuthenticated() && isBusinessMember(resource.data.businessId);
    }
    match /chart_of_accounts/{docId} {
      allow create, update: if isAuthenticated() && isBusinessMember(request.resource.data.businessId);
      allow delete: if isAuthenticated() && isBusinessMember(resource.data.businessId);
      allow read: if isAuthenticated() && isBusinessMember(resource.data.businessId);
    }
    match /invoices/{docId} {
      allow create, update: if isAuthenticated() && isBusinessMember(request.resource.data.businessId);
      allow delete: if isAuthenticated() && isBusinessMember(resource.data.businessId);
      allow read: if isAuthenticated() && isBusinessMember(resource.data.businessId);
    }
    match /bills/{docId} {
      allow create, update: if isAuthenticated() && isBusinessMember(request.resource.data.businessId);
      allow delete: if isAuthenticated() && isBusinessMember(resource.data.businessId);
      allow read: if isAuthenticated() && isBusinessMember(resource.data.businessId);
    }
    match /vendors/{docId} {
      allow create, update: if isAuthenticated() && isBusinessMember(request.resource.data.businessId);
      allow delete: if isAuthenticated() && isBusinessMember(resource.data.businessId);
      allow read: if isAuthenticated() && isBusinessMember(resource.data.businessId);
    }
    match /bank_accounts/{docId} {
      allow create, update: if isAuthenticated() && isBusinessMember(request.resource.data.businessId);
      allow delete: if isAuthenticated() && isBusinessMember(resource.data.businessId);
      allow read: if isAuthenticated() && isBusinessMember(resource.data.businessId);
    }
    match /recurring_transactions/{docId} {
      allow create, update: if isAuthenticated() && isBusinessMember(request.resource.data.businessId);
      allow delete: if isAuthenticated() && isBusinessMember(resource.data.businessId);
      allow read: if isAuthenticated() && isBusinessMember(resource.data.businessId);
    }
    match /mileage_logs/{docId} {
      allow create, update: if isAuthenticated() && isBusinessMember(request.resource.data.businessId);
      allow delete: if isAuthenticated() && isBusinessMember(resource.data.businessId);
      allow read: if isAuthenticated() && isBusinessMember(resource.data.businessId);
    }
    match /budgets/{docId} {
      allow create, update: if isAuthenticated() && isBusinessMember(request.resource.data.businessId);
      allow delete: if isAuthenticated() && isBusinessMember(resource.data.businessId);
      allow read: if isAuthenticated() && isBusinessMember(resource.data.businessId);
    }
    match /sales_tax_rates/{docId} {
      allow create, update: if isAuthenticated() && isBusinessMember(request.resource.data.businessId);
      allow delete: if isAuthenticated() && isBusinessMember(resource.data.businessId);
      allow read: if isAuthenticated() && isBusinessMember(resource.data.businessId);
    }
    match /conversations/{docId} {
      allow create, update: if isAuthenticated() && isBusinessMember(request.resource.data.businessId);
      allow delete: if isAuthenticated() && isBusinessMember(resource.data.businessId);
      allow read: if isAuthenticated() && isBusinessMember(resource.data.businessId);
    }

    // Time clock collections
    match /time_clock_logs/{docId} {
      allow create: if isAuthenticated() && isBusinessMember(request.resource.data.businessId);
      // Approval fields (who reviewed a punch, and the outcome) may only be
      // set by a manager -- an employee's own client can create their own
      // pending punch, but cannot self-approve it.
      allow update: if isAuthenticated() && isBusinessMember(request.resource.data.businessId) && (
        isManager() ||
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(
          ['approved', 'approvalStatus', 'approvedBy', 'approvedAt', 'rejectedBy', 'rejectedAt', 'rejectionReason']
        )
      );
      allow read, delete: if isAuthenticated() && isBusinessMember(resource.data.businessId);
    }
    match /active_shifts/{docId} {
      allow create, update: if isAuthenticated() && isBusinessMember(request.resource.data.businessId);
      // clockInTransaction/clockOutTransaction (timeClockService.ts) always
      // read this doc inside a transaction before creating/deleting it, to
      // guard against a double clock-in. Without the `resource == null`
      // branch, that very first read -- on a doc that doesn't exist yet --
      // can't evaluate resource.data at all and is denied outright, so the
      // whole feature silently fell back to the legacy business_profiles
      // compatibility store on every business's very first clock-in, every
      // time, and active_shifts (and therefore live GPS tracking, which
      // only reads from this collection) never actually got populated.
      allow read, delete: if isAuthenticated() && (resource == null || isBusinessMember(resource.data.businessId));
    }
    // One employee's real GPS breadcrumb trail for one shift (doc id ==
    // that shift's clock-in log id) -- survives clock-out for historical
    // review, unlike active_shifts' live-only position.
    match /shift_routes/{docId} {
      allow create, update: if isAuthenticated() && isBusinessMember(request.resource.data.businessId);
      allow read, delete: if isAuthenticated() && (resource == null || isBusinessMember(resource.data.businessId));
    }
    match /timeclock_states/{docId} {
      allow read, write: if isAuthenticated() && request.auth.token.email == docId;
    }

    // Push notification device tokens: a user manages only their own (the
    // server's send-push endpoint reads these via the Firebase Admin SDK,
    // which bypasses these rules entirely).
    match /push_subscriptions/{docId} {
      allow read, write: if isAuthenticated() && request.resource != null && request.resource.data.email == request.auth.token.email;
      allow read, delete: if isAuthenticated() && resource.data.email == request.auth.token.email;
    }

    // Owner'sLOCAL Customer -- a real, global customer identity (its own
    // Firebase Auth user), entirely separate from user_profiles/isBusinessMember
    // above. A signed-in customer manages only their own doc; nothing else
    // reads or writes this collection client-side (App.tsx's
    // onAuthStateChanged only ever reads its own uid's doc).
    // business_relationships and business_invite_codes are deliberately left
    // unmatched (default-deny) -- every one of those reads/writes goes
    // through the authenticated /api/customer-accounts/* server endpoints
    // (server/customerAccounts.ts, Firebase Admin SDK), which re-derive
    // which businesses a customer may see from their own confirmed Active
    // relationships instead of trusting anything the client sends.
    match /customer_accounts/{uid} {
      allow read, write: if isAuthenticated() && request.auth.uid == uid;
    }

    // Missed Call Text-Back companion app settings: one settings doc per
    // business, keyed by businessId (the owner's email, same tenant key used
    // everywhere else). Written from the OwnersLocal web app, read by the
    // separate Android companion app signed into this same Firebase project.
    match /missed_call_settings/{businessId} {
      allow read, write: if isAuthenticated() && isBusinessMember(businessId);
    }

    // One doc per missed call the companion Android app detected and
    // auto-replied to -- written by that app (signed in as the same owner
    // account as the web app, so the standard isBusinessMember check
    // applies exactly like every other collection), read by the web app's
    // Missed Call Text-Back log and the per-customer Call & Text History
    // panel.
    match /missed_call_events/{docId} {
      allow create, update: if isAuthenticated() && isBusinessMember(request.resource.data.businessId);
      allow delete: if isAuthenticated() && isBusinessMember(resource.data.businessId);
      allow read: if isAuthenticated() && isBusinessMember(resource.data.businessId);
    }

    // app_config/paywall_bypass holds the hashed (never plaintext) platform
    // admin access code for the OwnersLOCAL paywall -- see
    // server/paywallBypass.ts. Deliberately left unmatched here (default-deny
    // for every client, same reasoning as business_relationships/
    // business_invite_codes above): even the platform admin's own browser
    // never reads or writes this collection directly, only that file's
    // Admin SDK calls do, reached through the authenticated
    // /api/paywall/redeem and /api/paywall/set-code server routes.
  }
}
