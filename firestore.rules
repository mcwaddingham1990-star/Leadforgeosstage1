rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserProfile() {
      return get(/databases/$(database)/documents/user_profiles/$(request.auth.uid)).data;
    }

    function getBusinessEmail() {
      return getUserProfile().businessEmail;
    }

    // Fast path uses the auth token's own email directly (no cross-document
    // lookup) to cover the common owner case; falls back to the profile
    // lookup for employees whose businessId is their owner's email.
    //
    // SECURITY: the `businessId is string && businessId.size() > 0` guard
    // matters -- without it, a document missing its businessId field (a
    // malformed write, or a caller explicitly omitting it) makes this
    // compare against `null`. getBusinessEmail() also returns null for a
    // caller whose own profile happens to be missing businessEmail, so
    // `null == null` would otherwise evaluate true and grant that caller
    // access to a businessId-less document regardless of which business it
    // belongs to. Requiring a real non-empty string closes that off.
    function isBusinessMember(businessId) {
      return businessId is string && businessId.size() > 0 &&
        (request.auth.token.email == businessId || getBusinessEmail() == businessId);
    }

    // Backend authorization for the Owner-configured module permission matrix.
    // Owners always bypass module checks for their own tenant. Employees use
    // granularPermissions when present. Older employee profiles that only have
    // the legacy permissions[] list keep View + Create/Edit compatibility, but
    // never inherit Delete from that old list.
    function permissionAllows(permission, action) {
      return (permission is map && permission.get(action, false) == true)
        || (permission is string && (
          (action == "view" && permission in ["view", "edit", "delete"]) ||
          (action == "edit" && permission in ["edit", "delete"]) ||
          (action == "delete" && permission == "delete")
        ));
    }

    function employeeHasModulePermission(moduleId, action) {
      let profile = getUserProfile();
      let granular = profile.get("granularPermissions", {});
      let legacyModules = profile.get("permissions", []);
      let hasExplicit = granular is map && granular.keys().hasAny([moduleId]);
      let explicitPermission = hasExplicit ? granular.get(moduleId, null) : null;
      let legacyAllowed = !hasExplicit
        && legacyModules is list
        && moduleId in legacyModules
        && action in ["view", "edit"];
      return permissionAllows(explicitPermission, action) || legacyAllowed;
    }

    function hasModulePermission(businessId, moduleId, action) {
      return isBusinessMember(businessId) && (
        request.auth.token.email == businessId ||
        employeeHasModulePermission(moduleId, action)
      );
    }

    function hasSchedulingDataPermission(businessId, action) {
      return hasModulePermission(businessId, "scheduling", action)
        || hasModulePermission(businessId, "dispatch", action)
        || hasModulePermission(businessId, "jobs", action);
    }

    function hasGeneralDocumentPermission(businessId, action) {
      return hasModulePermission(businessId, "documents", action)
        || hasModulePermission(businessId, "pdf_editor", action);
    }

    function hasDocumentReadPermission(businessId) {
      return hasGeneralDocumentPermission(businessId, "view")
        || hasModulePermission(businessId, "esign", "view");
    }

    function hasESignWritePermission(businessId, action) {
      return hasModulePermission(businessId, "esign", action)
        || (action == "edit" && hasModulePermission(businessId, "collect_signatures", "edit"));
    }

    function hasMessagingPermission(businessId, action) {
      return hasModulePermission(businessId, "messages", action)
        || hasModulePermission(businessId, "missed_call_textback", action)
        || (action == "view" && hasModulePermission(businessId, "view_lead_messages", "view"));
    }

    // Only owners and managers may create or modify eSign / PDF documents.
    function isManager() {
      return getUserProfile().role in [
        "Owner", "General Manager", "Office Manager",
        "Operations Manager", "HR Manager", "Payroll Manager",
        "HR", "Payroll", "Admin"
      ];
    }

    function canManageProjectCompletion(businessId) {
      return hasModulePermission(businessId, "jobs", "edit");
    }

    // Owner or a role explicitly granted the Time Clock "Clock Employees
    // In/Out" capability may punch another employee. Existing built-in
    // manager profiles created before this capability existed retain the
    // intended default only while they have no explicit setting; once an
    // owner toggles it in Roles/Permissions, that explicit allow/deny wins.
    function canClockOtherEmployees(businessId) {
      let profile = getUserProfile();
      let granular = profile.granularPermissions;
      let hasExplicit = granular is map &&
        granular.keys().hasAny(['timeclock_team_punches']);
      let permission = hasExplicit ? granular.timeclock_team_punches : null;
      let explicitlyAllowed = hasExplicit && (
        (permission is map && permission.edit == true) ||
        (permission is string && permission in ['edit', 'delete'])
      );
      let legacyManagerDefault = !hasExplicit && profile.role in [
        'General Manager', 'Office Manager', 'Operations Manager'
      ];
      return isBusinessMember(businessId) &&
        (request.auth.token.email == businessId || explicitlyAllowed || legacyManagerDefault);
    }

    // SECURITY: businessId is required and checked against the job's own
    // record -- without it, a jobId belonging to a DIFFERENT business whose
    // assignedEmployee/assignedCrew text happens to match this caller's own
    // name/email would satisfy the assignment check below, letting a
    // project_completion_plans write for the caller's own business ride in
    // on a coincidental cross-business name match instead of a real
    // assignment on a job that business actually owns.
    function isAssignedToJob(jobId, businessId) {
      let job = get(/databases/$(database)/documents/scheduling_events/$(jobId)).data;
      let profile = getUserProfile();
      return job.businessId == businessId
        && (job.assignedEmployee == request.auth.token.email
          || job.assignedEmployee == profile.name
          || job.assignedEmployee == profile.firstName + " " + profile.lastName
          || job.assignedEmployee == profile.email
          || job.assignedCrew == profile.name);
    }

    // Profiles collection: users can read/write their own profiles.
    //
    // SECURITY: `businessEmail` and `role` on this document are the roots of
    // trust for the whole ruleset -- isBusinessMember() and isManager() above
    // read them straight off this doc. The original rule let a user
    // (request.auth.uid == uid) write *any* field of their own profile
    // unconditionally, which meant any authenticated user could self-edit
    // businessEmail to a victim business's email and role to "Owner" and
    // instantly gain full read/write over that business's data in every
    // other collection below -- a complete tenant-isolation and
    // privilege-escalation bypass. Self-writes may still touch every other
    // fields such as goals, but authorization and identity fields are pinned.
    // Owner/roster-admin changes use a separate guarded branch below. The other-member
    // branch (in practice: the business owner, whose auth token email
    // equals businessEmail -- see isBusinessMember's comment above) keeps
    // its original, unrestricted ability to edit an employee's profile
    // (e.g. RosterPage's role editor), unchanged from before.
    match /user_profiles/{uid} {
      allow read: if isAuthenticated() && (
        request.auth.uid == uid ||
        (resource != null && hasModulePermission(resource.data.businessEmail, "roster", "view"))
      );
      // SECURITY: the update rule below already pins businessEmail/role once
      // a profile exists, but that comparison needs a `resource` to compare
      // against -- on CREATE there isn't one yet, so without a check here a
      // brand-new authenticated user could set their own first profile's
      // businessEmail to any OTHER business's email (and role to "Owner")
      // and instantly inherit full read/write over that business's data via
      // isBusinessMember() everywhere else in this ruleset. Only two ways to
      // legitimately land a first businessEmail/role are now allowed:
      // (a) a real Owner self-signup, where businessEmail can only be the
      //     signer-upper's own verified auth email and role only "Owner"
      //     (matches App.tsx's owner-signup flows, which always set both
      //     this way); or (b) redeeming a real, still-open
      //     employee_invites/{code} doc -- which itself can only ever be
      //     created by an existing real member of that business
      //     (isBusinessMember() in that collection's own create rule) -- and
      //     the new profile's businessEmail/role must match that invite
      //     exactly, not whatever the new account claims. App.tsx's
      //     invite-signup flow now stamps the redeemed code onto the new
      //     profile as `inviteCode` specifically so this can verify it.
      allow create: if isAuthenticated() && request.auth.uid == uid && (
        (request.resource.data.businessEmail == request.auth.token.email && request.resource.data.role == "Owner")
        || (
          request.resource.data.inviteCode is string &&
          get(/databases/$(database)/documents/employee_invites/$(request.resource.data.inviteCode)).data.status == "pending" &&
          get(/databases/$(database)/documents/employee_invites/$(request.resource.data.inviteCode)).data.businessEmail == request.resource.data.businessEmail &&
          get(/databases/$(database)/documents/employee_invites/$(request.resource.data.inviteCode)).data.role == request.resource.data.role &&
          get(/databases/$(database)/documents/employee_invites/$(request.resource.data.inviteCode)).data.permissions == request.resource.data.permissions &&
          get(/databases/$(database)/documents/employee_invites/$(request.resource.data.inviteCode)).data.granularPermissions == request.resource.data.granularPermissions &&
          request.resource.data.isEmployee == true
        )
      );
      allow update: if isAuthenticated() && (
        // Normal self-service profile edits may change ordinary fields, but
        // the tenant root, role, and original invite proof stay pinned.
        (request.auth.uid == uid
          && request.resource.data.businessEmail == resource.data.businessEmail
          && request.resource.data.role == resource.data.role
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'businessEmail', 'role', 'inviteCode', 'permissions', 'granularPermissions',
            'isEmployee', 'requireTimeClockVerification', 'email',
            'name', 'firstName', 'lastName'
          ]))
        // Recovery path for an older/malformed employee profile whose saved
        // businessEmail points at the wrong tenant. The employee can repair
        // ONLY businessEmail, and only to the exact business + role proven by
        // the inviteCode that was ALREADY on their profile. They cannot first
        // swap in a different public invite code and then tenant-hop.
        || (request.auth.uid == uid
          && resource.data.inviteCode is string
          && request.resource.data.inviteCode == resource.data.inviteCode
          && request.resource.data.role == resource.data.role
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['businessEmail'])
          && get(/databases/$(database)/documents/employee_invites/$(resource.data.inviteCode)).data.status in ['pending', 'completed']
          && get(/databases/$(database)/documents/employee_invites/$(resource.data.inviteCode)).data.businessEmail == request.resource.data.businessEmail
          && get(/databases/$(database)/documents/employee_invites/$(resource.data.inviteCode)).data.role == resource.data.role)
        || (request.auth.uid == uid
          && request.resource.data.businessEmail == request.auth.token.email
          && request.resource.data.role == "Owner"
          && (
            (!resource.data.keys().hasAll(['businessEmail'])
              && (!resource.data.keys().hasAll(['role']) || resource.data.role == "Owner"))
            || (!resource.data.keys().hasAll(['role'])
              && resource.data.businessEmail == request.auth.token.email)
          ))
        || (request.auth.uid != uid
          && resource.data.businessEmail is string
          && hasModulePermission(resource.data.businessEmail, "roster", "edit")
          && request.resource.data.businessEmail == resource.data.businessEmail
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'role', 'permissions', 'granularPermissions', 'requireTimeClockVerification'
          ]))
        || (resource.data.businessEmail == request.auth.token.email
          && request.resource.data.businessEmail == resource.data.businessEmail)
      );
      allow delete: if isAuthenticated() && resource.data.businessEmail == request.auth.token.email;
    }

    // Business profiles: owners can read/write their business profile.
    //
    // SECURITY: subscriptionActive/subscriptionStatus/subscriptionCurrentPeriodEnd/
    // subscriptionCancelAtPeriodEnd/stripeSubscriptionCustomerId (server/
    // subscriptionRoutes.ts + server/stripeWebhook.ts) and bypassActive/
    // bypassExpiresAt (server/paywallBypass.ts) are the OwnersLOCAL paywall's
    // entire source of truth, and both are written exclusively through the
    // Firebase Admin SDK -- which bypasses these rules entirely, so this
    // costs those legitimate writes nothing. Without this restriction, any
    // business's own signed-in client could open devtools and
    // `setDoc(business_profiles/<their email>, {subscriptionActive: true})`
    // themselves, permanently defeating the entire paywall -- every existing
    // client write to this collection already uses `{merge: true}` (see
    // SettingsPage.tsx, RosterPage.tsx, UniversalAIIntake.tsx, App.tsx),
    // so blocking these specific keys from ever appearing in a client write
    // doesn't touch any real field those callers actually set.
    match /business_profiles/{email} {
      allow read: if isAuthenticated() && isBusinessMember(email);
      allow create: if isAuthenticated() && hasModulePermission(email, "settings", "edit") &&
        !request.resource.data.keys().hasAny([
          'subscriptionActive', 'subscriptionStatus', 'subscriptionCurrentPeriodEnd',
          'subscriptionCancelAtPeriodEnd', 'stripeSubscriptionCustomerId',
          'bypassActive', 'bypassExpiresAt'
        ]);
      allow update: if isAuthenticated() && hasModulePermission(email, "settings", "edit") &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'subscriptionActive', 'subscriptionStatus', 'subscriptionCurrentPeriodEnd',
          'subscriptionCancelAtPeriodEnd', 'stripeSubscriptionCustomerId',
          'bypassActive', 'bypassExpiresAt'
        ]);
      allow delete: if isAuthenticated() && hasModulePermission(email, "settings", "delete");
    }

    // Employee invites are bearer credentials: a person who knows one exact
    // code must be able to validate it before they have an account, but nobody
    // should be able to enumerate the collection. Creation/administration is
    // limited to the real business owner or a role the owner explicitly gave
    // Roster edit/delete permission. A delegated roster admin may invite staff,
    // but only the actual owner may issue an Owner-role invite.
    match /employee_invites/{code} {
      // Exact-code lookup used by the existing sign-up screen.
      allow get: if true;
      // Prevent public or authenticated bulk enumeration of bearer invite codes.
      allow list: if false;

      allow create: if isAuthenticated()
        && request.resource.data.code == code
        && request.resource.data.status == "pending"
        && (
          request.auth.token.email == request.resource.data.businessEmail
          || hasModulePermission(request.resource.data.businessEmail, "roster", "edit")
        )
        && (
          request.resource.data.role != "Owner"
          || request.auth.token.email == request.resource.data.businessEmail
        );

      // Roster administrators may maintain an invite inside their own tenant,
      // but cannot move it to another business or use delegated access to mint
      // an Owner invite. The invited user gets one narrow post-signup update:
      // mark this exact invite completed and stamp their own auth email.
      allow update: if isAuthenticated()
        && request.resource.data.businessEmail == resource.data.businessEmail
        && request.resource.data.code == resource.data.code
        && (
          (
            hasModulePermission(resource.data.businessEmail, "roster", "edit")
            && (
              request.resource.data.role != "Owner"
              || request.auth.token.email == resource.data.businessEmail
            )
          )
          || (
            resource.data.status == "pending"
            && request.resource.data.status == "completed"
            && request.resource.data.usedBy == request.auth.token.email
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "usedBy"])
            && getUserProfile().inviteCode == code
            && getUserProfile().businessEmail == resource.data.businessEmail
            && getUserProfile().role == resource.data.role
            && getUserProfile().permissions == resource.data.permissions
            && getUserProfile().granularPermissions == resource.data.granularPermissions
          )
        );

      allow delete: if isAuthenticated()
        && hasModulePermission(resource.data.businessEmail, "roster", "delete");
    }

    // Employees collection
    match /employees/{email} {
      allow read: if isAuthenticated() && isBusinessMember(resource.data.businessEmail);

      allow create: if isAuthenticated() && (
        hasModulePermission(request.resource.data.businessEmail, "roster", "edit")
        || (
          request.auth.token.email == email
          && request.resource.data.userUid == request.auth.uid
          && request.resource.data.businessEmail == getBusinessEmail()
          && request.resource.data.businessId == getBusinessEmail()
          && request.resource.data.role == getUserProfile().role
          && request.resource.data.permissions == getUserProfile().get("permissions", [])
          && request.resource.data.granularPermissions == getUserProfile().get("granularPermissions", {})
        )
      );

      allow update: if isAuthenticated()
        && request.resource.data.businessEmail == resource.data.businessEmail
        && (
          hasModulePermission(resource.data.businessEmail, "roster", "edit")
          || (
            request.auth.token.email == email
            && isBusinessMember(resource.data.businessEmail)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'address', 'phone', 'photo', 'goals', 'updatedAt'
            ])
          )
        );

      allow delete: if isAuthenticated()
        && hasModulePermission(resource.data.businessEmail, "roster", "delete");
    }

    // Standard business collections

    // Standard business collections — all scoped to businessId
    // (owner's email is the tenant key; employees have businessEmail in their
    // user_profile pointing back to the owner, handled by isBusinessMember)
    //
    // SECURITY: every "allow create, update" / "allow delete" pair below
    // used to be one combined "allow write" line reading
    // `request.resource == null || isBusinessMember(request.resource.data.businessId)`.
    // request.resource is null on a DELETE (there's no resulting document),
    // so that first half authorized EVERY delete unconditionally for any
    // authenticated user, regardless of which business the document
    // actually belonged to -- it never reached the isBusinessMember check at
    // all. Split so delete checks the EXISTING document's own businessId
    // (`resource.data`, not `request.resource.data`) instead of skipping it.

    match /customers/{docId} {
      allow create, update: if isAuthenticated() && hasModulePermission(request.resource.data.businessId, "customers", "edit");
      allow delete: if isAuthenticated() && hasModulePermission(resource.data.businessId, "customers", "delete");
      allow read: if isAuthenticated() && hasModulePermission(resource.data.businessId, "customers", "view");
    }

    match /leads/{docId} {
      allow create, update: if isAuthenticated() && hasModulePermission(request.resource.data.businessId, "leads", "edit");
      allow delete: if isAuthenticated() && hasModulePermission(resource.data.businessId, "leads", "delete");
      allow read: if isAuthenticated() && hasModulePermission(resource.data.businessId, "leads", "view");
    }

    match /estimates/{docId} {
      allow create, update: if isAuthenticated() && hasModulePermission(request.resource.data.businessId, "estimates", "edit");
      allow delete: if isAuthenticated() && hasModulePermission(resource.data.businessId, "estimates", "delete");
      allow read: if isAuthenticated() && hasModulePermission(resource.data.businessId, "estimates", "view");
    }

    match /scheduling_events/{docId} {
      allow create, update: if isAuthenticated() && hasSchedulingDataPermission(request.resource.data.businessId, "edit");
      allow delete: if isAuthenticated() && hasSchedulingDataPermission(resource.data.businessId, "delete");
      allow read: if isAuthenticated() && hasSchedulingDataPermission(resource.data.businessId, "view");
    }

    match /inventory/{docId} {
      allow create: if isAuthenticated() && hasModulePermission(request.resource.data.businessId, "inventory", "edit");
      allow delete: if isAuthenticated() && hasModulePermission(resource.data.businessId, "inventory", "delete");
      allow update: if isAuthenticated()
        && hasModulePermission(request.resource.data.businessId, "inventory", "edit")
        && (request.resource.data.quantity >= resource.data.quantity || canManageProjectCompletion(request.resource.data.businessId));
      allow read: if isAuthenticated() && hasModulePermission(resource.data.businessId, "inventory", "view");
    }

    match /project_completion_plans/{jobId} {
      allow read: if isAuthenticated()
        && hasModulePermission(resource.data.businessId, "jobs", "view");
      allow create: if isAuthenticated()
        && hasModulePermission(request.resource.data.businessId, "jobs", "edit")
        && request.resource.data.jobId == jobId
        && (canManageProjectCompletion(request.resource.data.businessId) || isAssignedToJob(jobId, request.resource.data.businessId));
      allow delete: if isAuthenticated()
        && hasModulePermission(resource.data.businessId, "jobs", "delete")
        && canManageProjectCompletion(resource.data.businessId);
      allow update: if isAuthenticated()
        && hasModulePermission(request.resource.data.businessId, "jobs", "edit")
        && request.resource.data.businessId == resource.data.businessId
        && request.resource.data.jobId == resource.data.jobId
        && (
          canManageProjectCompletion(request.resource.data.businessId)
          || (isAssignedToJob(resource.data.jobId, resource.data.businessId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['goals', 'activity', 'updatedAt']))
        );
    }

    match /documents/{docId} {
      allow create, update: if isAuthenticated()
        && (
          request.resource.data.folder == "eSign"
            ? hasESignWritePermission(request.resource.data.businessId, "edit")
            : hasGeneralDocumentPermission(request.resource.data.businessId, "edit")
        );
      allow delete: if isAuthenticated()
        && (
          resource.data.folder == "eSign"
            ? hasESignWritePermission(resource.data.businessId, "delete")
            : hasGeneralDocumentPermission(resource.data.businessId, "delete")
        );
      allow read: if isAuthenticated() && hasDocumentReadPermission(resource.data.businessId);
    }

    match /document_folders/{docId} {
      allow create, update: if isAuthenticated() && hasModulePermission(request.resource.data.businessId, "documents", "edit");
      allow delete: if isAuthenticated() && hasModulePermission(resource.data.businessId, "documents", "delete");
      allow read: if isAuthenticated() && hasModulePermission(resource.data.businessId, "documents", "view");
    }

    match /roster/{docId} {
      allow create, update: if isAuthenticated() && hasModulePermission(request.resource.data.businessId, "roster", "edit");
      allow delete: if isAuthenticated() && hasModulePermission(resource.data.businessId, "roster", "delete");
      allow read: if isAuthenticated() && hasModulePermission(resource.data.businessId, "roster", "view");
    }

    match /courses/{docId} {
      allow create, update: if isAuthenticated() && hasModulePermission(request.resource.data.businessId, "training", "edit");
      allow delete: if isAuthenticated() && hasModulePermission(resource.data.businessId, "training", "delete");
      allow read: if isAuthenticated() && hasModulePermission(resource.data.businessId, "training", "view");
    }

    match /training_profiles/{docId} {
      allow create, update: if isAuthenticated() && hasModulePermission(request.resource.data.businessId, "training", "edit");
      allow delete: if isAuthenticated() && hasModulePermission(resource.data.businessId, "training", "delete");
      allow read: if isAuthenticated() && hasModulePermission(resource.data.businessId, "training", "view");
    }

    match /bulletins/{docId} {
      allow create, update: if isAuthenticated() && isBusinessMember(request.resource.data.businessId);
      allow delete: if isAuthenticated() && isBusinessMember(resource.data.businessId);
      allow read: if isAuthenticated() && isBusinessMember(resource.data.businessId);
    }
    match /notifications/{docId} {
      // Any business member may create a notification (e.g. an employee's
      // clock-in creating an approval request addressed to their manager),
      // but only the addressed recipient may read, mark it read, or delete
      // it -- a notification is not a shared business-wide broadcast.
      allow create: if isAuthenticated() && isBusinessMember(request.resource.data.businessId);
      allow read, update, delete: if isAuthenticated() && isBusinessMember(resource.data.businessId)
        && resource.data.recipientEmail == request.auth.token.email;
    }
    match /recent_ai_actions/{docId} {
      allow create, update: if isAuthenticated() && hasModulePermission(request.resource.data.businessId, "ai_assistant", "edit");
      allow delete: if isAuthenticated() && hasModulePermission(resource.data.businessId, "ai_assistant", "delete");
      allow read: if isAuthenticated() && hasModulePermission(resource.data.businessId, "ai_assistant", "view");
    }

    match /snapshots/{docId} {
      allow create, update: if isAuthenticated() && isBusinessMember(request.resource.data.businessId);
      allow delete: if isAuthenticated() && isBusinessMember(resource.data.businessId);
      allow read: if isAuthenticated() && isBusinessMember(resource.data.businessId);
    }

    // Work Orders, Price Book, Memberships, Purchase Orders, Review Requests:
    // src/App.tsx's useFirestoreCollection calls for "work_orders",
    // "price_book_folders", "price_book_models", "memberships",
    // "purchase_orders", and "review_requests" had no matching rule here at
    // all, so every read/write to these tenant-scoped collections was
    // silently denied by Firestore's default-deny -- same isBusinessMember
    // scoping as every other standard business collection above.
    match /work_orders/{docId} {
      allow create, update: if isAuthenticated() && hasModulePermission(request.resource.data.businessId, "work_orders", "edit");
      allow delete: if isAuthenticated() && hasModulePermission(resource.data.businessId, "work_orders", "delete");
      allow read: if isAuthenticated() && hasModulePermission(resource.data.businessId, "work_orders", "view");
    }

    match /price_book_folders/{docId} {
      allow create, update: if isAuthenticated() && hasModulePermission(request.resource.data.businessId, "price_book", "edit");
      allow delete: if isAuthenticated() && hasModulePermission(resource.data.businessId, "price_book", "delete");
      allow read: if isAuthenticated() && hasModulePermission(resource.data.businessId, "price_book", "view");
    }

    match /price_book_models/{docId} {
      allow create, update: if isAuthenticated() && hasModulePermission(request.resource.data.businessId, "price_book", "edit");
      allow delete: if isAuthenticated() && hasModulePermission(resource.data.businessId, "price_book", "delete");
      allow read: if isAuthenticated() && hasModulePermission(resource.data.businessId, "price_book", "view");
    }

    match /memberships/{docId} {
      allow create, update: if isAuthenticated() && hasModulePermission(request.resource.data.businessId, "memberships", "edit");
      allow delete: if isAuthenticated() && hasModulePermission(resource.data.businessId, "memberships", "delete");
      allow read: if isAuthenticated() && hasModulePermission(resource.data.businessId, "memberships", "view");
    }

    match /purchase_orders/{docId} {
      allow create, update: if isAuthenticated() && hasModulePermission(request.resource.data.businessId, "purchase_orders", "edit");
      allow delete: if isAuthenticated() && hasModulePermission(resource.data.businessId, "purchase_orders", "delete");
      allow read: if isAuthenticated() && hasModulePermission(resource.data.businessId, "purchase_orders", "view");
    }

    match /review_requests/{docId} {
      allow create, update: if isAuthenticated() && hasModulePermission(request.resource.data.businessId, "marketing", "edit");
      allow delete: if isAuthenticated() && hasModulePermission(resource.data.businessId, "marketing", "delete");
      allow read: if isAuthenticated() && hasModulePermission(resource.data.businessId, "marketing", "view");
    }

    // Financial / accounting collections
    match /transactions/{docId} {
      allow create, update: if isAuthenticated() && (
        hasModulePermission(request.resource.data.businessId, "accounting", "edit")
        || hasModulePermission(request.resource.data.businessId, "payments", "edit")
      );
      allow delete: if isAuthenticated() && (
        hasModulePermission(resource.data.businessId, "accounting", "delete")
        || hasModulePermission(resource.data.businessId, "payments", "delete")
      );
      allow read: if isAuthenticated() && (
        hasModulePermission(resource.data.businessId, "accounting", "view")
        || hasModulePermission(resource.data.businessId, "payments", "view")
        || hasModulePermission(resource.data.businessId, "revenue", "view")
      );
    }

    match /journal_entries/{docId} {
      allow create, update: if isAuthenticated() && hasModulePermission(request.resource.data.businessId, "accounting", "edit");
      allow delete: if isAuthenticated() && hasModulePermission(resource.data.businessId, "accounting", "delete");
      allow read: if isAuthenticated() && hasModulePermission(resource.data.businessId, "accounting", "view");
    }

    match /revenue_events/{docId} {
      allow create, update: if isAuthenticated() && hasModulePermission(request.resource.data.businessId, "revenue", "edit");
      allow delete: if isAuthenticated() && hasModulePermission(resource.data.businessId, "revenue", "delete");
      allow read: if isAuthenticated() && hasModulePermission(resource.data.businessId, "revenue", "view");
    }

    match /chart_of_accounts/{docId} {
      allow create, update: if isAuthenticated() && hasModulePermission(request.resource.data.businessId, "accounting", "edit");
      allow delete: if isAuthenticated() && hasModulePermission(resource.data.businessId, "accounting", "delete");
      allow read: if isAuthenticated() && hasModulePermission(resource.data.businessId, "accounting", "view");
    }

    match /invoices/{docId} {
      allow create, update: if isAuthenticated() && (
        hasModulePermission(request.resource.data.businessId, "invoices", "edit")
        || hasModulePermission(request.resource.data.businessId, "accounting", "edit")
      );
      allow delete: if isAuthenticated() && (
        hasModulePermission(resource.data.businessId, "invoices", "delete")
        || hasModulePermission(resource.data.businessId, "accounting", "delete")
      );
      allow read: if isAuthenticated() && (
        hasModulePermission(resource.data.businessId, "invoices", "view")
        || hasModulePermission(resource.data.businessId, "accounting", "view")
        || hasModulePermission(resource.data.businessId, "revenue", "view")
      );
    }

    match /bills/{docId} {
      allow create, update: if isAuthenticated() && hasModulePermission(request.resource.data.businessId, "accounting", "edit");
      allow delete: if isAuthenticated() && hasModulePermission(resource.data.businessId, "accounting", "delete");
      allow read: if isAuthenticated() && hasModulePermission(resource.data.businessId, "accounting", "view");
    }

    match /vendors/{docId} {
      allow create, update: if isAuthenticated() && hasModulePermission(request.resource.data.businessId, "accounting", "edit");
      allow delete: if isAuthenticated() && hasModulePermission(resource.data.businessId, "accounting", "delete");
      allow read: if isAuthenticated() && hasModulePermission(resource.data.businessId, "accounting", "view");
    }

    match /bank_accounts/{docId} {
      allow create, update: if isAuthenticated() && hasModulePermission(request.resource.data.businessId, "accounting", "edit");
      allow delete: if isAuthenticated() && hasModulePermission(resource.data.businessId, "accounting", "delete");
      allow read: if isAuthenticated() && hasModulePermission(resource.data.businessId, "accounting", "view");
    }

    match /recurring_transactions/{docId} {
      allow create, update: if isAuthenticated() && hasModulePermission(request.resource.data.businessId, "accounting", "edit");
      allow delete: if isAuthenticated() && hasModulePermission(resource.data.businessId, "accounting", "delete");
      allow read: if isAuthenticated() && hasModulePermission(resource.data.businessId, "accounting", "view");
    }

    match /mileage_logs/{docId} {
      allow create, update: if isAuthenticated() && hasModulePermission(request.resource.data.businessId, "accounting", "edit");
      allow delete: if isAuthenticated() && hasModulePermission(resource.data.businessId, "accounting", "delete");
      allow read: if isAuthenticated() && hasModulePermission(resource.data.businessId, "accounting", "view");
    }

    match /budgets/{docId} {
      allow create, update: if isAuthenticated() && hasModulePermission(request.resource.data.businessId, "accounting", "edit");
      allow delete: if isAuthenticated() && hasModulePermission(resource.data.businessId, "accounting", "delete");
      allow read: if isAuthenticated() && hasModulePermission(resource.data.businessId, "accounting", "view");
    }

    match /sales_tax_rates/{docId} {
      allow create, update: if isAuthenticated() && hasModulePermission(request.resource.data.businessId, "accounting", "edit");
      allow delete: if isAuthenticated() && hasModulePermission(resource.data.businessId, "accounting", "delete");
      allow read: if isAuthenticated() && hasModulePermission(resource.data.businessId, "accounting", "view");
    }

    match /conversations/{docId} {
      allow create, update: if isAuthenticated() && hasModulePermission(request.resource.data.businessId, "messages", "edit");
      allow delete: if isAuthenticated() && hasModulePermission(resource.data.businessId, "messages", "delete");
      allow read: if isAuthenticated() && hasModulePermission(resource.data.businessId, "messages", "view");
    }

    // Time clock collections
    match /time_clock_logs/{docId} {
      allow create: if isAuthenticated() && isBusinessMember(request.resource.data.businessId)
        && (
          (request.resource.data.employeeEmail == request.auth.token.email
            && hasModulePermission(request.resource.data.businessId, "timeclock", "edit"))
          || canClockOtherEmployees(request.resource.data.businessId)
        );

      allow update: if isAuthenticated()
        && request.resource.data.businessId == resource.data.businessId
        && (
          (resource.data.employeeEmail == request.auth.token.email
            && hasModulePermission(resource.data.businessId, "timeclock", "edit")
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(
              ['approved', 'approvalStatus', 'approvedBy', 'approvedAt', 'rejectedBy', 'rejectedAt', 'rejectionReason']
            ))
          || canClockOtherEmployees(resource.data.businessId)
        );

      allow read: if isAuthenticated()
        && hasModulePermission(resource.data.businessId, "timeclock", "view");

      allow delete: if isAuthenticated()
        && hasModulePermission(resource.data.businessId, "timeclock", "delete")
        && (
          resource.data.employeeEmail == request.auth.token.email
          || canClockOtherEmployees(resource.data.businessId)
        );
    }

    match /active_shifts/{docId} {
      allow create, update: if isAuthenticated() && isBusinessMember(request.resource.data.businessId)
        && (
          (request.resource.data.employeeEmail == request.auth.token.email
            && hasModulePermission(request.resource.data.businessId, "timeclock", "edit"))
          || canClockOtherEmployees(request.resource.data.businessId)
        );
      allow read: if isAuthenticated() && (
        resource == null ||
        hasModulePermission(resource.data.businessId, "timeclock", "view") ||
        canClockOtherEmployees(resource.data.businessId)
      );
      allow delete: if isAuthenticated() && isBusinessMember(resource.data.businessId)
        && (
          (resource.data.employeeEmail == request.auth.token.email
            && hasModulePermission(resource.data.businessId, "timeclock", "edit"))
          || canClockOtherEmployees(resource.data.businessId)
        );
    }

    // One employee's real GPS breadcrumb trail

    // One employee's real GPS breadcrumb trail for one shift (doc id ==
    // that shift's clock-in log id) -- survives clock-out for historical
    // review, unlike active_shifts' live-only position.
    match /shift_routes/{docId} {
      allow create, update: if isAuthenticated() && (
        hasModulePermission(request.resource.data.businessId, "routes", "edit")
        || hasModulePermission(request.resource.data.businessId, "employee_locations", "edit")
        || hasModulePermission(request.resource.data.businessId, "timeclock", "edit")
      );
      allow read: if isAuthenticated() && (
        resource == null ||
        hasModulePermission(resource.data.businessId, "routes", "view")
        || hasModulePermission(resource.data.businessId, "employee_locations", "view")
        || hasModulePermission(resource.data.businessId, "timeclock", "view")
      );
      allow delete: if isAuthenticated() && (
        hasModulePermission(resource.data.businessId, "routes", "delete")
        || hasModulePermission(resource.data.businessId, "employee_locations", "delete")
      );
    }

    match /timeclock_states/{docId} {
      allow read, write: if isAuthenticated() && request.auth.token.email == docId;
    }

    // Push notification device tokens: a user manages only their own (the
    // server's send-push endpoint reads these via the Firebase Admin SDK,
    // which bypasses these rules entirely).
    match /push_subscriptions/{docId} {
      allow read, write: if isAuthenticated() && request.resource != null && request.resource.data.email == request.auth.token.email;
      allow read, delete: if isAuthenticated() && resource.data.email == request.auth.token.email;
    }

    // Owner'sLOCAL Customer -- a real, global customer identity (its own
    // Firebase Auth user), entirely separate from user_profiles/isBusinessMember
    // above. A signed-in customer manages only their own doc; nothing else
    // reads or writes this collection client-side (App.tsx's
    // onAuthStateChanged only ever reads its own uid's doc).
    // business_relationships and business_invite_codes are deliberately left
    // unmatched (default-deny) -- every one of those reads/writes goes
    // through the authenticated /api/customer-accounts/* server endpoints
    // (server/customerAccounts.ts, Firebase Admin SDK), which re-derive
    // which businesses a customer may see from their own confirmed Active
    // relationships instead of trusting anything the client sends.
    match /customer_accounts/{uid} {
      allow read, write: if isAuthenticated() && request.auth.uid == uid;
    }

    // Missed Call Text-Back companion app settings: one settings doc per
    // business, keyed by businessId (the owner's email, same tenant key used
    // everywhere else). Written from the OwnersLocal web app, read by the
    // separate Android companion app signed into this same Firebase project.
    match /missed_call_settings/{businessId} {
      allow read: if isAuthenticated() && (
        hasModulePermission(businessId, "missed_call_textback", "view")
        || hasModulePermission(businessId, "messages", "view")
      );
      allow create, update: if isAuthenticated() && hasModulePermission(businessId, "missed_call_textback", "edit");
      allow delete: if isAuthenticated() && hasModulePermission(businessId, "missed_call_textback", "delete");
    }

    // One doc per missed call

    // One doc per missed call the companion Android app detected and
    // auto-replied to -- written by that app (signed in as the same owner
    // account as the web app, so the standard isBusinessMember check
    // applies exactly like every other collection), read by the web app's
    // Missed Call Text-Back log and the per-customer Call & Text History
    // panel.
    match /missed_call_events/{docId} {
      allow create, update: if isAuthenticated() && hasMessagingPermission(request.resource.data.businessId, "edit");
      allow delete: if isAuthenticated() && hasMessagingPermission(resource.data.businessId, "delete");
      allow read: if isAuthenticated() && hasMessagingPermission(resource.data.businessId, "view");
    }

    // One doc per real SMS

    // One doc per real SMS (either direction) the companion Android app
    // has seen -- an incoming customer reply (SmsReceiver.kt) or an
    // outgoing text actually sent from the owner's phone, whether that's
    // the automated missed-call reply or a manual reply typed into the
    // native Messages app (OutgoingSmsObserver.kt). Same write/read shape
    // as missed_call_events; read by the web app's business-wide Inbox and
    // the per-customer Call & Text History panel.
    match /text_messages/{docId} {
      allow create, update: if isAuthenticated() && hasMessagingPermission(request.resource.data.businessId, "edit");
      allow delete: if isAuthenticated() && hasMessagingPermission(resource.data.businessId, "delete");
      allow read: if isAuthenticated() && hasMessagingPermission(resource.data.businessId, "view");
    }

    // app_config/paywall_bypass

    // app_config/paywall_bypass holds the hashed (never plaintext) platform
    // admin access code for the OwnersLOCAL paywall -- see
    // server/paywallBypass.ts. Deliberately left unmatched here (default-deny
    // for every client, same reasoning as business_relationships/
    // business_invite_codes above): even the platform admin's own browser
    // never reads or writes this collection directly, only that file's
    // Admin SDK calls do, reached through the authenticated
    // /api/paywall/redeem and /api/paywall/set-code server routes.
  }
}
