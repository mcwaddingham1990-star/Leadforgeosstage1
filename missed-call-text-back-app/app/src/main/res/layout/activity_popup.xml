<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/popupRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ===== Main popup: one glass window on the starfield, thin glowing border ===== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/mainCard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="center"
        android:layout_marginHorizontal="18dp"
        android:clickable="true"
        android:focusable="false"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="28dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/glass_border"
        app:strokeWidth="1dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.9"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/popup_starfield" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/glass_overlay" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:contentDescription="@null"
                    android:src="@drawable/pulse_4" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="Notifications"
                    android:textColor="@color/glass_text"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/closeButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Close"
                    android:gravity="center"
                    android:text="✕"
                    android:textColor="@color/glass_subtext"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/tileApp"
                    style="@style/GlassTile">

                    <TextView
                        android:id="@+id/countApp"
                        style="@style/GlassTileCount" />

                    <TextView
                        style="@style/GlassTileLabel"
                        android:text="@string/tile_app" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tileCalls"
                    style="@style/GlassTile"
                    android:layout_marginHorizontal="8dp">

                    <TextView
                        android:id="@+id/countCalls"
                        style="@style/GlassTileCount" />

                    <TextView
                        style="@style/GlassTileLabel"
                        android:text="@string/tile_calls" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tileMessages"
                    style="@style/GlassTile">

                    <TextView
                        android:id="@+id/countMessages"
                        style="@style/GlassTileCount" />

                    <TextView
                        style="@style/GlassTileLabel"
                        android:text="@string/tile_messages" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Missed calls &amp; texts"
                    android:textColor="@color/glass_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/clearPhoneButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:padding="6dp"
                    android:text="Mark all done"
                    android:textColor="@color/glass_subtext"
                    android:textSize="12sp" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="4dp"
                android:layout_weight="1"
                android:fadingEdgeLength="16dp"
                android:requiresFadingEdge="vertical">

                <LinearLayout
                    android:id="@+id/phoneList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/preferencesButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="Set missed call response preferences"
                android:textColor="@color/glass_text"
                android:textSize="15sp"
                app:cornerRadius="18dp"
                app:strokeColor="@color/glass_border" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ===== Secondary popup: smaller, borderless, on top of the main one ===== -->
    <View
        android:id="@+id/secondaryScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#55000000"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/secondaryCard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="center"
        android:layout_marginHorizontal="30dp"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone"
        app:cardBackgroundColor="@color/glass_secondary"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/secondaryBack"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Back"
                    android:gravity="center"
                    android:text="‹"
                    android:textColor="@color/glass_text"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/secondaryTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/glass_text"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/secondaryAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:padding="8dp"
                    android:textColor="#7FC3FF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/secondaryContent"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
