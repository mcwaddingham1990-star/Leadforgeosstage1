# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_MAPS_PLATFORM_KEY: Required for loading real, interactive Google Maps on the dispatch dashboard.
GOOGLE_MAPS_PLATFORM_KEY=

# GOOGLE_MAPS_MAP_ID: Required alongside GOOGLE_MAPS_PLATFORM_KEY for the map's
# custom marker styling (Advanced Markers). Map IDs are tied to a specific
# Google Cloud project (Console -> Maps -> Map Management) -- it must belong
# to the SAME project as the API key above, or markers will fail to render.
GOOGLE_MAPS_MAP_ID=

# Plaid Sandbox banking connection. Configure these only on the server.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Push notifications (e.g. "clock in/out needs your approval" alerts to an
# owner/manager's own device). Both must be set together -- one authorizes
# the browser to request a subscription, the other authorizes the server to
# actually send to it. The real-time in-app Alert Center (sidebar bell)
# already works fully without either of these; they only add true push
# delivery for when the app/tab is closed.

# FIREBASE_VAPID_KEY: public by design (only proves this app's origin may
# request a push subscription). Get it from Firebase Console -> Project
# Settings -> Cloud Messaging -> Web Push certificates -> Generate key pair.
FIREBASE_VAPID_KEY=

# FIREBASE_SERVICE_ACCOUNT_JSON: the full contents of a service account key
# file (as one JSON string) -- keep this secret, server-side only. Get it
# from Firebase Console -> Project Settings -> Service Accounts -> Generate
# new private key. See server/pushNotifications.ts for exactly how it's used.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Named Firestore database used by this project. The default below matches
# firebase-applet-config.json and is used by the recurring scheduler.
FIREBASE_DATABASE_ID=ai-studio-leadforgelocalos-a91c76d6-18b0-4f96-b3fb-ef1e755e81f4

# Long random bearer token for an external Render Cron Job calling:
# POST /api/jobs/process-recurring with Authorization: Bearer <token>
RECURRING_CRON_SECRET=
