# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_MAPS_PLATFORM_KEY: Required for loading real, interactive Google Maps on the dispatch dashboard.
GOOGLE_MAPS_PLATFORM_KEY=

# GOOGLE_MAPS_MAP_ID: Required alongside GOOGLE_MAPS_PLATFORM_KEY for the map's
# custom marker styling (Advanced Markers). Map IDs are tied to a specific
# Google Cloud project (Console -> Maps -> Map Management) -- it must belong
# to the SAME project as the API key above, or markers will fail to render.
GOOGLE_MAPS_MAP_ID=

# Stripe -- used both for bank-account linking/reconciliation (Financial
# Connections webhook events) and the owner subscription paywall (OwnersLOCAL
# charging the business owners who use the app -- see server/subscriptionRoutes.ts).
# STRIPE_SECRET_KEY talks to Stripe's API; STRIPE_WEBHOOK_SECRET verifies
# that a POST to /api/stripe/webhook actually came from Stripe (get it from
# the Dashboard when you create the webhook destination pointing at that
# URL, under Developers -> Webhooks). Without STRIPE_WEBHOOK_SECRET set,
# that endpoint responds 503 rather than accepting unverified events.
STRIPE_SECRET_KEY=
# Platform-account webhook (POST /api/stripe/webhook) -- OwnersLOCAL's own
# subscription billing events. Subscribe this destination to at least:
# customer.subscription.created, customer.subscription.updated,
# customer.subscription.deleted.
STRIPE_WEBHOOK_SECRET=
# The Price ID (starts with "price_") for OwnersLOCAL's own base
# subscription plan -- create a Product + recurring Price in the Stripe
# Dashboard (Products catalog, NOT a connected account) and paste its
# Price ID here. Without this set (and STRIPE_SECRET_KEY),
# /api/subscription/checkout and the Billing screen's "Subscribe" button
# respond 503 rather than silently doing nothing.
STRIPE_BASE_PRICE=
# The Price ID for the additional-seats add-on: $20/month per extra block
# of 5 employees beyond the 5 included in the base price (owner + 5
# employees included free). Only required once a business actually has
# more than 5 employees -- checkout fails loudly rather than silently
# under-charging if that happens before this is set.
STRIPE_ADDITIONAL_SEATS_PRICE=
# Connected-account webhook (POST /api/stripe/connect-webhook) -- events
# from businesses' own connected Stripe accounts (connect: true in the
# Stripe Dashboard when creating this webhook destination). Different
# destination, different signing secret than STRIPE_WEBHOOK_SECRET above,
# even though both live on the same server.
STRIPE_CONNECT_WEBHOOK_SECRET=

# Public counterpart to STRIPE_SECRET_KEY -- safe to ship to the browser
# (same relationship as Firebase's web apiKey). Required for the embedded
# Stripe Connect onboarding/payments UI in the Payments tab. Get it from
# the Stripe Dashboard -> Developers -> API keys, right next to the secret
# key. Read at BUILD time (baked into the client bundle via vite.config.ts),
# not at server runtime -- changing it requires a rebuild/redeploy.
STRIPE_PUBLISHABLE_KEY=

# Push notifications (e.g. "clock in/out needs your approval" alerts to an
# owner/manager's own device). Both must be set together -- one authorizes
# the browser to request a subscription, the other authorizes the server to
# actually send to it. The real-time in-app Alert Center (sidebar bell)
# already works fully without either of these; they only add true push
# delivery for when the app/tab is closed.

# FIREBASE_VAPID_KEY: public by design (only proves this app's origin may
# request a push subscription). Get it from Firebase Console -> Project
# Settings -> Cloud Messaging -> Web Push certificates -> Generate key pair.
FIREBASE_VAPID_KEY=

# FIREBASE_SERVICE_ACCOUNT_JSON: the full contents of a service account key
# file (as one JSON string) -- keep this secret, server-side only. Get it
# from Firebase Console -> Project Settings -> Service Accounts -> Generate
# new private key. Used by server/pushNotifications.ts (push notifications)
# and server/remoteSigning.ts (the "send remotely" e-signing link) -- without
# this set, "Send remotely" in the PDF Editor shows "not configured yet"
# instead of generating a working link.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Named Firestore database used by this project. The default below matches
# firebase-applet-config.json and is used by the recurring scheduler.
FIREBASE_DATABASE_ID=ai-studio-leadforgelocalos-a91c76d6-18b0-4f96-b3fb-ef1e755e81f4

# Long random bearer token for an external Render Cron Job calling:
# POST /api/jobs/process-recurring with Authorization: Bearer <token>
RECURRING_CRON_SECRET=
