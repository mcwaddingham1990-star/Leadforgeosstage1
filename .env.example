# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_MAPS_PLATFORM_KEY: Required for loading real, interactive Google Maps on the dispatch dashboard.
GOOGLE_MAPS_PLATFORM_KEY=

# GOOGLE_MAPS_MAP_ID: Required alongside GOOGLE_MAPS_PLATFORM_KEY for the map's
# custom marker styling (Advanced Markers). Map IDs are tied to a specific
# Google Cloud project (Console -> Maps -> Map Management) -- it must belong
# to the SAME project as the API key above, or markers will fail to render.
GOOGLE_MAPS_MAP_ID=

# Plaid Sandbox banking connection. Configure these only on the server.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# SELFIESAVE_EMBED_SECRET: shared HMAC secret with the SelfieSave eSign app,
# used to mint short-lived embed tickets so SelfieSave can skip its own
# "Sign in with ChatGPT" gate when opened inside Owners Local's PDF editor
# popup. Must be set to the SAME value on SelfieSave's server too. Leave
# unset to keep the (working) popup-window fallback -- see
# server/selfieSaveEmbed.ts for the ticket format SelfieSave needs to verify.
SELFIESAVE_EMBED_SECRET=
